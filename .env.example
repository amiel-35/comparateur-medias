# Copier en .env pour un essai local avec Docker ; sur Coolify, saisir ces variables dans l'interface.

# Clé API Anthropic (mode « api » de la fabrique). Secret : ne jamais la committer.
ANTHROPIC_API_KEY=

# Plafond de dépense modèle par jour, en dollars au tarif public. La fabrique s'arrête au-delà.
COMPARATEUR_BUDGET_JOUR_USD=2

# Récolte des flux : intervalle en minutes (0 = fabrique coupée, lancée par une tâche planifiée externe).
COMPARATEUR_FABRIQUE_MINUTES=180

# Heure (0-23, heure de Paris) de l'édition quotidienne : regroupement, analyse et publication, une fois par jour.
COMPARATEUR_EDITION_HEURE=6

# Fenêtre d'une édition, en heures.
COMPARATEUR_HEURES=24

# Rubriques écartées du regroupement et des sujets, séparées par des virgules. La rubrique est lue dans l'adresse
# de l'article (/sport/, /culture/...), sans modèle ; les articles écartés restent en base.
# Rubriques reconnues : sport, culture, politique, international, economie, societe, faits-divers, sciences,
# environnement, opinions. « aucune » pour ne rien écarter.
COMPARATEUR_RUBRIQUES_ECARTEES=sport,culture

# Votants requis dans chaque bord pour publier une note à l'aveugle sans la mention « indicatif ».
COMPARATEUR_MIN_PAR_BORD=5

# Mesure de fréquentation par Umami, sans cookie. Vide : aucune mesure. L'identifiant est le data-website-id
# donné par Umami pour ce site ; le script et les domaines suivis ont une valeur par défaut.
COMPARATEUR_UMAMI_ID=
# COMPARATEUR_UMAMI_SCRIPT=https://stats.inflexion.me/script.js
# COMPARATEUR_UMAMI_DOMAINES=compare-media.inflexion.me

# La synthèse de la semaine par mail, envoyée le lundi en SMTP (Brevo). Sans utilisateur ou sans mot de passe,
# la fonction est éteinte : ni formulaire, ni envoi. Le mot de passe est la clé SMTP de Brevo : secret.
COMPARATEUR_SMTP_UTILISATEUR=
COMPARATEUR_SMTP_MOT_DE_PASSE=
# COMPARATEUR_SMTP_HOTE=smtp-relay.brevo.com
# COMPARATEUR_SMTP_PORT=587
# COMPARATEUR_MAIL_EXPEDITEUR=no-reply@inflexion.me
# COMPARATEUR_MAIL_NOM=Cadrages
# Adresse publique du site, pour les liens des mails.
# COMPARATEUR_SITE_URL=https://compare-media.inflexion.me

# Sauvegardes : une copie de la base chaque jour, gardée N jours dans <données>/sauvegardes/.
# COMPARATEUR_SAUVEGARDE_JOURS=14
# Copie hors du serveur, en WebDAV (HTTPS), vers une Storage Box Hetzner : adresse du dossier, utilisateur, mot de
# passe (secret). Vide : copies sur place seulement, qui ne protègent pas de la perte du serveur.
COMPARATEUR_SAUVEGARDE_URL=
COMPARATEUR_SAUVEGARDE_UTILISATEUR=
COMPARATEUR_SAUVEGARDE_MOT_DE_PASSE=

# Hors Docker seulement : cli = `claude -p` (abonnement, sans clé) ; api = API Anthropic.
# COMPARATEUR_LLM=cli
# COMPARATEUR_DONNEES=./donnees
# PORT=8080
