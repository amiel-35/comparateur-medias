{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export d'une édition de Cadrages",
  "description": "Une édition gardée, champ par champ, identique pour tous. Version 1. Les champs écrits par un modèle de langage sont listés dans ecrit_par_un_modele. Ce site ne classe aucun média : le score et la bande d'un média classé sont ceux de FrIdéo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "jour",
    "versions",
    "methode_des_comptages",
    "licences",
    "ecrit_par_un_modele",
    "heures",
    "total",
    "medias",
    "absents",
    "non_classes",
    "sujets",
    "seuls"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "jour": {
      "$ref": "#/$defs/jour"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methode",
        "classement"
      ],
      "properties": {
        "methode": {
          "type": "string",
          "description": "Version de la méthode ; chaîne vide pour une édition d'avant la version 1.0."
        },
        "classement": {
          "type": "string",
          "description": "Version du classement, par exemple « FrIdéo v1.0 » ; vide si inconnue."
        }
      }
    },
    "methode_des_comptages": {
      "type": "string",
      "description": "La version de la méthode qui a refait les comptages (bande, par_bande, cotes_silencieux) à la publication. Distincte de versions.methode, celle du jour de l'édition."
    },
    "licences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "classement",
        "titres"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "classement": {
          "type": "string"
        },
        "titres": {
          "type": "string"
        }
      }
    },
    "ecrit_par_un_modele": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Les champs écrits par un modèle de langage."
    },
    "heures": {
      "type": "integer",
      "minimum": 1,
      "description": "Largeur de la fenêtre de lecture, en heures."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Titres lus dans la fenêtre."
    },
    "medias": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "absents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sujets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sujet"
      }
    },
    "seuls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    }
  },
  "$defs": {
    "jour": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nom",
        "statut",
        "score",
        "bande"
      ],
      "properties": {
        "nom": {
          "type": "string"
        },
        "statut": {
          "type": "string",
          "enum": [
            "classe",
            "non-classe"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Score FrIdéo ; null pour un média non classé."
        },
        "bande": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "extreme-gauche",
            "gauche",
            "centre-gauche",
            "centre",
            "centre-droit",
            "droite",
            "extreme-droite",
            null
          ],
          "description": "Bande FrIdéo ; null pour un média non classé."
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media",
        "titre",
        "lien"
      ],
      "properties": {
        "media": {
          "type": "string"
        },
        "titre": {
          "type": "string"
        },
        "lien": {
          "type": "string"
        }
      }
    },
    "sujet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titre",
        "fait",
        "divergence",
        "analyse",
        "mots",
        "articles",
        "par_bande",
        "cotes_silencieux"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[0-9]+$"
        },
        "titre": {
          "type": "string"
        },
        "fait": {
          "type": "string"
        },
        "divergence": {
          "type": [
            "integer",
            "null"
          ]
        },
        "analyse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "g",
            "c",
            "d"
          ],
          "properties": {
            "g": {
              "type": "string"
            },
            "c": {
              "type": "string"
            },
            "d": {
              "type": "string"
            }
          }
        },
        "mots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "terme",
              "qui"
            ],
            "properties": {
              "terme": {
                "type": "string"
              },
              "qui": {
                "type": "string"
              }
            }
          }
        },
        "articles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/article"
          }
        },
        "par_bande": {
          "type": "object",
          "description": "Titres du sujet par bande, comptés par du code. Un média non classé n'est dans aucune bande.",
          "additionalProperties": false,
          "required": [
            "extreme-gauche",
            "gauche",
            "centre-gauche",
            "centre",
            "centre-droit",
            "droite",
            "extreme-droite"
          ],
          "properties": {
            "extreme-gauche": {
              "type": "integer",
              "minimum": 0
            },
            "gauche": {
              "type": "integer",
              "minimum": 0
            },
            "centre-gauche": {
              "type": "integer",
              "minimum": 0
            },
            "centre": {
              "type": "integer",
              "minimum": 0
            },
            "centre-droit": {
              "type": "integer",
              "minimum": 0
            },
            "droite": {
              "type": "integer",
              "minimum": 0
            },
            "extreme-droite": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cotes_silencieux": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "g",
              "c",
              "d"
            ]
          },
          "description": "Côtés sans aucun titre sur un sujet repris par au moins quatre médias."
        }
      }
    }
  }
}
